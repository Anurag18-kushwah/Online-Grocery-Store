# Copy to server/.env (never commit the real file). Placeholders only.
PORT=4000
# Only needed when the client is served from a different origin (e.g. Vite dev on 5173 uses the proxy, so leave blank)
CLIENT_ORIGIN=

# --- Database: choose ONE ---
# A) MongoDB / Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/grocerai
# B) No MongoDB: file-backed dev store (uncomment, and leave MONGODB_URI empty)
# STORE_MODE=local

JWT_SECRET=change-me-to-a-long-random-string

# --- Optional LLM (the app is fully functional without one) ---
LLM_PROVIDER=none            # none | bedrock | openai-compatible
LLM_TIMEOUT_MS=12000
# bedrock: credentials come from the standard AWS chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or an IAM role)
AWS_REGION=
BEDROCK_MODEL_ID=
# openai-compatible (OpenAI, Groq, Together, Ollama's /v1, …)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
