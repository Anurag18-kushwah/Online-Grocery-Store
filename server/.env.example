# Copy to server/.env (never commit the real file). Placeholders only.
PORT=4000
# Only needed when the client is served from a different origin (e.g. Vite dev on 5173 uses the proxy, so leave blank)
CLIENT_ORIGIN=

# --- Database: choose ONE ---
# A) MongoDB / Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/grocerai
# B) No MongoDB: file-backed dev store (uncomment, and leave MONGODB_URI empty)
# STORE_MODE=local

JWT_SECRET=change-me-to-a-long-random-string

# --- Optional LLM (the app is fully functional without one) ---
LLM_PROVIDER=none            # none | bedrock | openai-compatible
LLM_TIMEOUT_MS=12000
# bedrock: credentials come from the standard AWS chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or an IAM role)
AWS_REGION=
BEDROCK_MODEL_ID=
# openai-compatible (OpenAI, Groq, Together, Ollama's /v1, …)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=


# --- Admin order notifications (optional) ---
# Email via Resend: create an API key and use a verified sender address.
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
EMAIL_FROM=GrocerAI <orders@your-verified-domain.com>

# WhatsApp via Twilio. For sandbox, join the sandbox from ADMIN_WHATSAPP_TO first.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# Razorpay payment gateway (use Test Mode keys first; never expose Key Secret in the client)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
