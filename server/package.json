{
  "name": "grocerai-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "dev:local": "STORE_MODE=local node --watch src/index.js",
    "start:local": "STORE_MODE=local node src/index.js",
    "seed": "node src/scripts/seed.js",
    "images": "node src/scripts/generateImages.js",
    "photos": "node src/scripts/fetchPhotos.js",
    "setup": "node src/scripts/setup.js",
    "photos:pick": "node src/scripts/photoPicker.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0"
  }
}
